# Proveedor de LLM (Anthropic). Sin clave, el chat funciona en modo sin LLM (reglas deterministas).
ANTHROPIC_API_KEY=
# Opcional
MODEL=claude-sonnet-5-5
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=45000
PRECIO_INPUT_MTOK=3
PRECIO_OUTPUT_MTOK=15
# Directorio de salida (por defecto ./out; en Vercel /tmp/out)
OUT_DIR=
